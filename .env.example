# ============================================================
#  ASO Audit Agent — environment
#
#  Everything here is OPTIONAL. With ZERO keys set, `npm run dev`
#  works end to end: scores are computed deterministically and the
#  action plan is generated from a built-in template. Adding keys
#  progressively unlocks a richer audit.
# ============================================================

# ---- LLM analyst (NVIDIA NIM — OpenAI-compatible, free tier) ----
# Get a key + free credits at https://build.nvidia.com (OpenAI-compatible API).
# WITHOUT this, the app falls back to a deterministic, template-based action
# plan — scores are unaffected either way (they're always computed in TS).
NIM_API_KEY=
# Override only if you use a different OpenAI-compatible endpoint.
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
# Any chat model NIM exposes. A large instruct model is recommended.
NIM_MODEL=openai/gpt-oss-120b

# ---- Subtitle scraping (Firecrawl) ----
# The App Store subtitle is NOT in Apple's public API. With a Firecrawl key we
# extract it reliably; without one we fall back to a best-effort HTML parse and,
# failing that, honestly mark the subtitle as "not observable".
# Get a free key at https://firecrawl.dev
FIRECRAWL_API_KEY=

# ---- Defaults ----
# Storefront to use when an App Store URL omits the country segment.
DEFAULT_COUNTRY=us

# ---- Deployment wiring (only needed when the two apps are deployed apart) ----
# The web app (Vercel) reaches the Mastra server through this origin.
# Locally you don't need to set it — it defaults to http://localhost:4111.
MASTRA_SERVER_URL=http://localhost:4111
# Comma-separated allowed origins for the Mastra server's CORS. Set this to your
# Vercel URL in production (e.g. https://your-app.vercel.app). Defaults to "*".
CORS_ORIGIN=
# Durable storage for suspended workflow runs. Defaults to a local SQLite file.
# In production point this at a hosted libSQL/Turso database.
LIBSQL_URL=file:./aso-audit.db

# Screenshot OCR — reads on-image text to fully score the Screenshots dimension.
# OFF by default (slow: WASM download + a few seconds/image). Set to true to enable.
ENABLE_OCR=false
