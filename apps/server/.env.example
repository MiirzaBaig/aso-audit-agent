# Mastra server env. Copy to apps/server/.env (or set in your host's dashboard).
# ALL OPTIONAL — the server runs with zero keys (deterministic template audit).

# NVIDIA NIM (OpenAI-compatible, free tier) — https://build.nvidia.com
NIM_API_KEY=
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_MODEL=meta/llama-3.3-70b-instruct

# Firecrawl (subtitle scraping) — https://firecrawl.dev
FIRECRAWL_API_KEY=

# Defaults & wiring
DEFAULT_COUNTRY=us
# Allowed browser origins for CORS (set to your Vercel URL in prod). Defaults to *.
CORS_ORIGIN=
# Durable storage for suspended runs. Defaults to a local SQLite file.
LIBSQL_URL=file:./aso-audit.db
