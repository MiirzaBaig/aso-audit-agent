    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22",
    "mastra": "^1.27.1",
    "tsx": "^4.23.12",
    "typescript": "^5.6.3",
    "vitest": "^4.1.11"
  }
}
