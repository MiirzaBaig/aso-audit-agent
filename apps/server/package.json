{
  "name": "@aso/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "mastra dev --dir src/mastra",
    "build": "mastra build --dir src/mastra",
    "start": "node .mastra/output/index.mjs",
    "typecheck": "tsc --noEmit",
